# =============================================================================
# Monorepo root .gitignore — MEDICINE-EXPIRY-PROJECT
# =============================================================================

# ----- Secrets / environment (NEVER commit) -----
.env
.env.*
!.env.example
!**/.env.example

# ----- Python -----
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/*.egg-info/
**/build/
**/dist/
**/wheels/
**/.venv/
**/venv/
**/env/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
**/.tox/
**/.cache/

# ----- Node / frontend -----
**/node_modules/
**/dist/
**/dist-ssr/
**/*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----- Backend runtime / local artifacts -----
**/storage/
combo_results/
combo_results_yolo_first/
test_output_images/
*_results.json
complete_images_analysis*.json
qwen_json_fix_smoke.json
enhanced_output.jpg
dates.csv

# ----- ML / Ultralytics caches (keep *.pt weights that are part of the repo) -----
**/runs/
*.pt.bak

# ----- Notebooks / IDE / OS -----
**/*.ipynb
**/.ipynb_checkpoints/
**/.vscode/
**/.idea/
.DS_Store
Thumbs.db
Desktop.ini

# ----- Logs -----
**/logs/
**/*.log
