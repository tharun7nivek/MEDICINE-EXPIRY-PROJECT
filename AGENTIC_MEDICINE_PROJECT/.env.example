# Copy to .env and fill in real values. NEVER commit .env.
#
# Key rotation accepts ANY count of keys per provider. Use whichever style
# you prefer (they can be mixed; duplicates are ignored):
#
#   OPENROUTER_API_KEY=...
#   OPENROUTER_API_KEY_2=...
#   OPENROUTER_API_KEY_3=...          # …_N for any N
#
#   GROQ_API_KEYS=key1,key2,key3      # comma-separated alternative
#
# At least one OpenRouter key and one Groq key are required.

OPENROUTER_API_KEY=
# OPENROUTER_API_KEY_2=
# OPENROUTER_API_KEY_3=

GROQ_API_KEY=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=

# Optional — defaults to <backend>/storage (portable, no absolute paths needed)
# STORAGE_DIR=
# CORS_ORIGINS=http://localhost:5173
# RETAIN_DETECT_TEMPS=false

# true = original pipeline (raw RGB crops only; dewarp/morph ignored)
# false = first_read gets dewarped helper, reflection gets morph helper
RAW_CROP_PIPELINE=true

# Optional — Listen uses Microsoft Edge neural TTS (no API key).
# TTS_RATE_LIMIT_PER_MINUTE=20
